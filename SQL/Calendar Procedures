CREATE PROCEDURE `getEventsByMonthYear`(
	IN `_month` INT,
	IN `_year` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN
	SELECT ID, EventStart, EventEnd, Title, Description FROM calendar
	WHERE MONTH(EventStart) = _month AND YEAR(EventStart) = _year;
END

CREATE PROCEDURE `getEvents`()
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN
	SELECT ID, EventStart, EventEnd, Title, Description FROM calendar;
END

CREATE PROCEDURE `getEventByID`(
	IN `_id` INT
)
LANGUAGE SQL
NOT DETERMINISTIC
CONTAINS SQL
SQL SECURITY DEFINER
COMMENT ''
BEGIN
 SELECT ID, EventStart, EventEnd, Title, Description FROM calendar WHERE ID = _id;
END