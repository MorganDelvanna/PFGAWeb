    <link rel="stylesheet" href="../css/menu.css" />   
    <link rel="icon" href="../images/pfgalogo.ico" type="image/icon type">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
  </head>

